# 前端 nginx 也是反向代理的一跳；仅 /api/ 生成 span，静态资源不产生噪音。
otel_exporter {
    # gRPC 端点；K8s 下为 jaeger:4317，Compose 默认 127.0.0.1:4317
    endpoint ${OTEL_EXPORTER_ENDPOINT};
}
otel_service_name openassassin-frontend;
# 默认是 ignore；代理必须 propagate 才能 extract + inject W3C traceparent
otel_trace_context propagate;

server {
    listen 80;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # No cache for HTML (always fetch latest to get new asset hashes)
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
    }

    # Cache hashed assets (JS/CSS) - safe because filename changes on content change
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /api/ {
        # 仅 API 请求生成前端 span；静态页面由 Ingress span 覆盖
        otel_trace ${OTEL_TRACE_MODE};
        proxy_pass http://backend:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
    }
}
