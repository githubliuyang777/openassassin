JWT_SECRET=change-me-to-a-random-string
MASTER_KEY=change-me-master-key-32-bytes!!
ADMIN_DEFAULT_PASSWORD=admin
ADMIN_EMAIL=
DATABASE_URL=sqlite:///./data/ops.db
SANDBOX_IMAGE_SHELL=alpine:3.20
SANDBOX_IMAGE_PYTHON=python:3.12-alpine
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=true
ALERT_EMAIL=admin@example.com
ALERT_BEFORE_DAYS=7
ALERT_CHECK_INTERVAL_MINUTES=60

# Host Agent 告警配置
HOST_AGENT_OFFLINE_MINUTES=5
HOST_AGENT_METRICS_RETENTION_DAYS=7
HOST_AGENT_ALERT_CPU_PERCENT=90
HOST_AGENT_ALERT_MEM_PERCENT=90
HOST_AGENT_ALERT_DISK_PERCENT=85
HOST_AGENT_ALERT_CONSECUTIVE=3
