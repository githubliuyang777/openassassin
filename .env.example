JWT_SECRET=change-me-to-a-random-string
MASTER_KEY=change-me-master-key-32-bytes!!
ADMIN_DEFAULT_PASSWORD=admin
ADMIN_EMAIL=
DATABASE_URL=sqlite:///./data/ops.db
SANDBOX_IMAGE_SHELL=alpine:3.20
SANDBOX_IMAGE_PYTHON=python:3.12-alpine
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=true
ALERT_EMAIL=admin@example.com
ALERT_BEFORE_DAYS=7
ALERT_CHECK_INTERVAL_MINUTES=60
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_CPU_LIMIT=0.5
SANDBOX_DEFAULT_TIMEOUT=300
SANDBOX_MAX_TIMEOUT=3600
SSH_CONNECT_TIMEOUT=10
SSH_TERMINAL_IDLE_TIMEOUT=3600
AUDIT_ENABLED=true
AUDIT_IP_SOURCE=forwarded
AUDIT_LOG_RETENTION_DAYS=180
AUDIT_IP_GEOLOCATION=false
TOTP_ISSUER=openAssassin
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
