JWT_SECRET=change-me-to-a-random-string
MASTER_KEY=change-me-master-key-32-bytes!!
ADMIN_DEFAULT_PASSWORD=admin
ADMIN_EMAIL=
DATABASE_URL=sqlite:///./data/ops.db
SANDBOX_IMAGE_SHELL=alpine:3.20
SANDBOX_IMAGE_PYTHON=python:3.12-alpine
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=true
ALERT_EMAIL=admin@example.com
ALERT_BEFORE_DAYS=7
ALERT_CHECK_INTERVAL_MINUTES=60
# CORS: comma-separated origin allowlist (production is same-origin via nginx)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Set to true only if you accept sending client IPs to ip-api.com for audit geolocation
AUDIT_IP_GEOLOCATION=false
# Login / reset rate limiting
LOGIN_FAILED_LIMIT=5
LOGIN_IP_LIMIT=30
LOGIN_WINDOW_SECONDS=300
RESET_CODE_LIMIT=5
RESET_CODE_WINDOW_SECONDS=900
