# openAssassin 非敏感配置（由 configMapGenerator 生成 ConfigMap）
# 敏感项（JWT_SECRET / MASTER_KEY / ADMIN_DEFAULT_PASSWORD / SMTP_PASSWORD /
# SMTP_FALLBACK_PASSWORD）请通过 Secret openassassin-secrets 注入，不要写在此文件。

ENABLE_API_DOCS=false
DATABASE_URL=sqlite:///./data/ops.db
LOG_DIR=/app/data/logs

# K8s 环境没有 Docker socket，暂时关闭脚本沙箱执行功能。
# 执行脚本时会返回 [SANDBOX_DISABLED] 提示，其余功能正常。
SANDBOX_ENABLED=false
SANDBOX_TMP_DIR=/tmp/openassassin-sandbox

# 链路追踪：Jaeger v2 直接接收 OTLP。TRACING_UI_URL 为浏览器可
# 访问的 Jaeger UI 地址；留空则只显示 trace_id，不生成跳转链接。
TRACING_ENABLED=true
TRACING_UI_URL=https://jaeger.ly1996.xyz
OTEL_SERVICE_NAME=openassassin-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# 有界队列，Jaeger 不可达时丢 span 而不拖垮业务
OTEL_BSP_MAX_QUEUE_SIZE=2048
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512

JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

AUDIT_ENABLED=true
AUDIT_IP_SOURCE=forwarded
AUDIT_LOG_RETENTION_DAYS=180

SSH_CONNECT_TIMEOUT=10
SSH_TERMINAL_IDLE_TIMEOUT=3600

ALERT_BEFORE_DAYS=7
ALERT_CHECK_INTERVAL_MINUTES=60
TOTP_ISSUER=openAssassin

AWS_DEFAULT_REGION=ap-southeast-1
AWS_REGIONS=ap-southeast-1,us-east-1,eu-west-1

# SMTP 非敏感参数；SMTP_PASSWORD 和 SMTP_FALLBACK_PASSWORD 在 Secret 中
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_FROM=
SMTP_USE_TLS=true
# 备用 SMTP：仅告警邮件使用；主失败/熔断时切换
SMTP_FALLBACK_HOST=
SMTP_FALLBACK_PORT=587
SMTP_FALLBACK_USERNAME=
SMTP_FALLBACK_FROM=
SMTP_FALLBACK_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15
SMTP_ALERT_TIMEOUT_SECONDS=10
SMTP_ALERT_TOTAL_BUDGET_SECONDS=25
SMTP_ALERT_CIRCUIT_FAILURES=3
SMTP_ALERT_CIRCUIT_OPEN_SECONDS=300
# 未配置通知组时的兜底告警收件人；留空则仅能通过通知组发送
ALERT_EMAIL=
ADMIN_EMAIL=

HOST_AGENT_OFFLINE_MINUTES=5
HOST_AGENT_METRICS_RETENTION_DAYS=7
HOST_AGENT_ALERT_CPU_PERCENT=90
HOST_AGENT_ALERT_MEM_PERCENT=90
HOST_AGENT_ALERT_DISK_PERCENT=85
HOST_AGENT_ALERT_CONSECUTIVE=3
